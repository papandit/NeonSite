# =============================================================================
# NameCraft server env — copy to server/.env and fill in.
# Required vars are validated on boot; the server refuses to start if any are
# missing (see src/config/index.js).
# =============================================================================

# --- Core (REQUIRED) ---------------------------------------------------------
NODE_ENV=development
PORT=5000

# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/namecraft

# JWT (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# --- CORS: which frontends may call this API ---------------------------------
# Comma-separated list of allowed origins (customer + admin dev servers).
CLIENT_CUSTOMER_ORIGIN=http://localhost:5173
CLIENT_ADMIN_ORIGIN=http://localhost:5174

# --- Initial admin seed (used by `npm run seed:admin`) -----------------------
SEED_ADMIN_NAME=NameCraft Admin
SEED_ADMIN_EMAIL=admin@namecraft.local
SEED_ADMIN_PASSWORD=Admin@12345

# --- Cloudinary (REQUIRED from Phase 1.2 onward; optional in Phase 0) --------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Razorpay (REQUIRED from Phase 4 onward; optional in Phase 0) ------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- SMTP (REQUIRED from Phase 6.2 onward; optional in Phase 0) --------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="NameCraft <no-reply@namecraft.local>"

# --- Google Fonts Developer API (optional — full font catalogue in admin) ----
# Get a key at https://developers.google.com/fonts/docs/developer_api
GOOGLE_FONTS_API_KEY=
